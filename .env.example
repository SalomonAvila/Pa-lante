# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# La clave "publishable" (sb_publishable_…), NO la "secret".
# La secret salta RLS: si llega al navegador, expone toda la base de datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# --- Servidor MCP (mcp/) — solo servidor, NUNCA con prefijo NEXT_PUBLIC_ ---
# Clave "secret" de Supabase: la usa el servidor MCP para resolver tokens,
# porque un agente llama sin sesión de navegador y RLS no aplica.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# Token de demo para probar el MCP sin base de datos ni ingesta real.
# Quítalo en producción.
MCP_DEMO_TOKEN=palante_demo_local

# Puerto del servidor MCP.
MCP_PORT=3333

# --- Onboarding conversacional (ElevenLabs) ---
# Server-side. Se usa para crear/editar el agente vía API, nunca en el cliente.
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxx
# El agent_id no es secreto — el SDK del cliente lo necesita para abrir sesión.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxx

# --- Orquestador de inteligencia financiera (web/src/lib/inteligencia/) ---
# Servidor únicamente (web/), nunca en el cliente ni con prefijo NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# Opcional — default claude-opus-5 si no se define.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Embeddings para el RAG mínimo (conocimiento documental). Opcional: sin
# esta clave, la tool buscar_conocimiento_financiero responde "no disponible"
# en vez de fallar.
VOYAGE_API_KEY=pa-xxxxxxxxxxxx
