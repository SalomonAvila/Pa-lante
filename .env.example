# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# La clave "publishable" (sb_publishable_…), NO la "secret".
# La secret salta RLS: si llega al navegador, expone toda la base de datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# --- Servidor MCP (mcp/) — solo servidor, NUNCA con prefijo NEXT_PUBLIC_ ---
# Clave "secret" de Supabase: la usa el servidor MCP para resolver tokens,
# porque un agente llama sin sesión de navegador y RLS no aplica.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# Token de demo para probar el MCP sin base de datos ni ingesta real.
# Quítalo en producción.
MCP_DEMO_TOKEN=palante_demo_local

# Puerto del servidor MCP.
MCP_PORT=3333
