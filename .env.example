# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# La clave "publishable" (sb_publishable_…), NO la "secret".
# La secret salta RLS: si llega al navegador, expone toda la base de datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Solo para el servidor MCP (mcp/) — nunca en el cliente web ni en .env.local del navegador.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx
