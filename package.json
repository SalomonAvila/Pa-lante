{
  "name": "palante",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "mcp"
  ],
  "scripts": {
    "dev": "bun run --cwd web dev",
    "build": "bun run --cwd web build",
    "start": "bun run --cwd web start",
    "lint": "bun run --cwd web lint",
    "mcp:dev": "bun run --cwd mcp dev",
    "mcp:build": "bun run --cwd mcp build"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "zod": "4.4.3"
  }
}
